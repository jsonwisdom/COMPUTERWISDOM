{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jsonwisdom.io/schemas/ci-first-budget-v0.3.json",
  "type":"object","additionalProperties":false,
  "required":["schema","budget_context_id","owner","authorized_callers","global_cap_micro_usd","agent_caps_micro_usd","created_at","expires_at","authorization","authority_created"],
  "properties": {
    "schema":{"const":"computerwisdom.ci-first.budget.v0.3"},
    "budget_context_id":{"type":"string","minLength":3},"owner":{"type":"string","minLength":3},
    "authorized_callers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":3}},
    "global_cap_micro_usd":{"type":"integer","minimum":0},
    "agent_caps_micro_usd":{"type":"object","minProperties":1,"additionalProperties":{"type":"integer","minimum":0}},
    "created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},
    "authorization":{"const":"MOCK_FIXTURE_ONLY"},"authority_created":{"const":false}
  }
}
