{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.io/schemas/ci-first-adapter-invocation-v0.3.json",
  "title": "Computer Wisdom CI-FIRST v0.3 invocation envelope",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version","adapter_version","case_id","agent_id","invocation_id","idempotency_key","caller_identity","budget_context_id","provider","model_id","model_revision_requested","endpoint_id","prompt_sha256","parameters_sha256","tool_allowlist_sha256","price_schedule_sha256","max_input_tokens","max_output_tokens","global_cap_micro_usd","agent_cap_micro_usd","invocation_created_at","connect_timeout_ms","first_byte_timeout_ms","total_timeout_ms","reservation_ttl_seconds","canon","authority_created","payment","wallet_signing"],
  "properties": {
    "contract_version": {"const":"computerwisdom.ci-first.adapter.v0.3"},
    "adapter_version": {"const":"0.3.0-mock"},
    "case_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,79}$"},
    "agent_id": {"$ref":"#/$defs/id"},
    "invocation_id": {"$ref":"#/$defs/id"},
    "idempotency_key": {"$ref":"#/$defs/id"},
    "caller_identity": {"$ref":"#/$defs/id"},
    "budget_context_id": {"$ref":"#/$defs/id"},
    "provider": {"const":"mock"},
    "model_id": {"$ref":"#/$defs/id"},
    "model_revision_requested": {"$ref":"#/$defs/id"},
    "endpoint_id": {"$ref":"#/$defs/id"},
    "prompt_sha256": {"$ref":"#/$defs/sha256"},
    "parameters_sha256": {"$ref":"#/$defs/sha256"},
    "tool_allowlist_sha256": {"$ref":"#/$defs/sha256"},
    "price_schedule_sha256": {"$ref":"#/$defs/sha256"},
    "max_input_tokens": {"type":"integer","minimum":1,"maximum":200000},
    "max_output_tokens": {"type":"integer","minimum":1,"maximum":64000},
    "global_cap_micro_usd": {"type":"integer","minimum":0},
    "agent_cap_micro_usd": {"type":"integer","minimum":0},
    "invocation_created_at": {"type":"string","format":"date-time"},
    "connect_timeout_ms": {"type":"integer","minimum":1},
    "first_byte_timeout_ms": {"type":"integer","minimum":1},
    "total_timeout_ms": {"type":"integer","minimum":1,"maximum":120000},
    "reservation_ttl_seconds": {"type":"integer","minimum":1},
    "canon": {"const":false},"authority_created":{"const":false},"payment":{"const":false},"wallet_signing":{"const":false}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,95}$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
