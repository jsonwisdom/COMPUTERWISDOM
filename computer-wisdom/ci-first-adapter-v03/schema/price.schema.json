{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jsonwisdom.io/schemas/ci-first-price-v0.3.json",
  "type":"object","additionalProperties":false,
  "required":["schema","currency","unit","input_usd_per_1k","output_usd_per_1k","cached_input_usd_per_1k","effective_from","effective_to","source_url","fetched_at","fetched_by","fetch_method"],
  "properties":{
    "schema":{"const":"computerwisdom.ci-first.price.v0.3"},
    "currency":{"const":"USD"},"unit":{"const":"per_1000_tokens"},
    "input_usd_per_1k":{"$ref":"#/$defs/money"},"output_usd_per_1k":{"$ref":"#/$defs/money"},"cached_input_usd_per_1k":{"$ref":"#/$defs/money"},
    "effective_from":{"type":"string","format":"date-time"},"effective_to":{"type":"string","format":"date-time"},
    "source_url":{"type":"string","format":"uri"},"fetched_at":{"type":"string","format":"date-time"},"fetched_by":{"type":"string","minLength":3},"fetch_method":{"type":"string","minLength":3}
  },
  "$defs":{"money":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"}}
}
