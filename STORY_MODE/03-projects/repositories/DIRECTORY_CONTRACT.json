{
  "CONTRACT_VERSION": "1.0.0",
  "DIRECTORY": "STORY_MODE/03-projects/repositories",
  "PURPOSE": "Govern direct repository traversal inventories and per-repository Story Mode route proposals.",
  "MAY_CONTAIN": [
    "DIRECTORY_CONTRACT.json",
    "versioned repository inventory JSON",
    "versioned per-repository route objects"
