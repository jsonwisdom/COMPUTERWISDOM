      "source_class": "OFFICIAL_DOD_PUBLIC_RECORD",
      "page_bytes_sealed": false
    },
    {
      "id": "MILDENHALL_2024_MOD_LAND",
      "state": "SOURCE_BOUND_TEXT",
      "claim": "In 2024 the UK Ministry of Defence purchased land adjacent to RAF Mildenhall for base-defense/security space; the USAF release said no firm future development plan existed until survey and assessment.",
