      "page_bytes_sealed": false
    },
    {
      "id": "MILDENHALL_1992_100_ARW",
      "state": "SOURCE_BOUND_TEXT",
      "claim": "The 100th Air Refueling Wing activated at RAF Mildenhall on 1992-02-01 and became the host wing.",
      "source_url": "https://www.mildenhall.af.mil/About-Us/Fact-Sheets/Display/Article/270390/100th-air-refueling-wing-history/",
      "source_class": "OFFICIAL_USAF_PUBLIC_RECORD",
      "page_bytes_sealed": false
    },
    {
      "id": "MILDENHALL_2015_DIVEST_PLAN",
      "state": "SOURCE_BOUND_TEXT",
      "claim": "In 2015 DoD announced a plan to divest RAF Mildenhall and relocate major operational units.",
      "source_url": "https://www.defense.gov/News/Releases/Release/Article/605338/dod-announces-european-infrastructure-consolidation-actions-and-f-35-basing-in/",
      "source_class": "OFFICIAL_DOD_PUBLIC_RECORD",
      "page_bytes_sealed": false
    },
    {
      "id": "MILDENHALL_2020_RETAIN",
      "state": "SOURCE_BOUND_TEXT",
      "claim": "In the 2020 EUCOM force-posture update, DoD said roughly 2,500 Airmen at Mildenhall responsible for aerial refueling and special operations, previously scheduled to re-base to Germany, would remain in the United Kingdom.",
