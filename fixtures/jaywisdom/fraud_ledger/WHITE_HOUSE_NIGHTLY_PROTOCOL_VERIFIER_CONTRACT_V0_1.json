    {"ordinal": 5, "id": "LANE_MAP_SHA256", "class_on_violation": "LANE_MAP_VIOLATION"},
    {"ordinal": 6, "id": "RECORDED_LANE_MATCH", "class_on_violation": "LANE_MAP_VIOLATION"},
