{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.local/schemas/public_question_intake.v0_1.schema.json",
  "title": "Public Question Intake v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "submitted_at",
    "question_text",
    "question_class",
    "portal_status_due_at",
    "authority_candidates",
    "record_requests",
    "legal_clocks",
    "replay_state",
    "authority_created"
  ],
  "properties": {
    "question_id": {"type": "string", "pattern": "^Q-[0-9]{8}-[A-Z0-9_-]+$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "question_text": {"type": "string", "minLength": 1},
    "question_class": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AUTHORITY",
          "PUBLIC_RECORD",
          "MONEY",
          "CONTRACT",
          "TRAVEL",
          "LODGING",
          "COURT_RECORD",
          "OIG",
          "CONGRESSIONAL_OVERSIGHT",
          "DATA_ACCESS",
          "GEOLOCATION",
          "CUSTODY",
          "OTHER"
        ]
      }
    },
    "portal_status_due_at": {"type": "string", "format": "date-time"},
    "portal_sla_hours": {"const": 24},
    "authority_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["office", "basis", "status"],
        "properties": {
          "office": {"type": "string"},
          "person": {"type": ["string", "null"]},
          "basis": {"type": "string"},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "status": {
            "enum": [
              "PROPOSED_BY_AI",
              "SOURCE_BOUND_CANDIDATE",
              "AUTHORITY_EDGE_PROVEN",
              "AUTHORITY_EDGE_REJECTED",
              "HOLD"
            ]
          }
        }
      }
    },
    "record_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "custodian_status", "request_status"],
        "properties": {
          "record_type": {"type": "string"},
          "custodian": {"type": ["string", "null"]},
          "custodian_status": {"enum": ["PROPOSED", "BOUND", "CONFLICT", "UNKNOWN"]},
          "request_status": {
            "enum": [
              "NOT_REQUESTED",
              "PUBLICLY_AVAILABLE",
              "REQUESTED",
              "ACKNOWLEDGED",
              "PARTIAL",
              "RECEIVED",
              "WITHHELD",
              "SEALED",
              "NO_RESPONSE_OBSERVED"
            ]
          },
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "legal_clocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clock_name", "source", "status"],
        "properties": {
          "clock_name": {"type": "string"},
          "deadline_at": {"type": ["string", "null"], "format": "date-time"},
          "source": {"type": "string"},
          "status": {"enum": ["INFORMATIONAL", "RUNNING", "PAUSED", "EXPIRED", "SATISFIED", "NOT_APPLICABLE"]}
        }
      }
    },
    "portal_status": {
      "enum": [
        "QUESTION_ACCEPTED",
        "DIRECTORY_MATERIALIZED",
        "CANDIDATE_AUTHORITY_ROUTED",
        "ANSWER_RECEIVED",
        "RECORDS_RECEIVED",
        "ACKNOWLEDGMENT_RECEIVED",
        "ROUTED_TO_STATUTORY_PROCESS",
        "NO_RESPONSE_OBSERVED",
        "JURISDICTION_UNRESOLVED"
      ]
    },
    "replay_state": {"enum": ["PASS", "HOLD", "CONFLICT", "REJECT"]},
    "authority_created": {"const": false}
  }
}
