{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/gray_baby/batch_receipt.schema.json",
  "title": "Gray Baby batch receipt",
  "description": "REPLAY_RECEIPT_SPEC_V1 envelope for one Gray Baby batch. Counts are factual. Authority stays false. Replay kernel replay() is not invoked on non-ERS inventory objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "schema_version",
    "receipt_id",
    "batch_id",
    "identity_ref",
    "identity_class",
    "human_identity",
    "action_ref",
    "timestamp",
    "source_artifacts",
    "replay_parameters",
    "output",
    "INPUT_OBJECTS",
    "state_counts",
    "OPERATORS_AVAILABLE",
    "OPERATORS_USED",
    "MANUAL_REVIEWS",
    "manual_review_object_ids",
    "REPEATED_ERRORS_PREVENTED",
    "AUTHORITY_CREATED",
    "authority",
    "authority_boundary",
    "mode",
    "batch_start",
    "batch_size",
    "inventory_class",
    "kernel_version",
    "kernel_replay_invoked",
    "constitutional_root",
    "network",
    "secrets_used",
    "chain_data_fabricated",
    "promotion_performed",
    "design_inventory_size",
    "design_batch_size",
    "fixture_note",
    "object_ids",
    "queue_object_ids",
    "specialist_object_ids",
    "deep_replay_object_ids",
    "receipt_object_ids",
    "human_summary_ref",
    "scorekeeper_note",
    "receipt_writer_status"
  ],
  "properties": {
    "spec": { "const": "REPLAY_RECEIPT_SPEC_V1" },
    "schema_version": { "const": "GRAY_BABY_BATCH_RECEIPT_V1" },
    "receipt_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "batch_id": { "type": "string", "pattern": "^GRAY_BABY_BATCH_[0-9]{3}$" },
    "identity_ref": { "type": "string", "minLength": 1 },
    "identity_class": { "const": "ROLE" },
    "human_identity": { "type": "null" },
    "action_ref": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "commit", "sha256", "role"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "replay_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "hash_algorithm", "verifier_version", "scope", "network", "clock"],
      "properties": {
        "canonicalization": { "type": "string", "minLength": 1 },
        "hash_algorithm": { "const": "SHA-256" },
        "verifier_version": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "network": { "const": "NONE" },
        "clock": { "const": "INPUT_TIMESTAMPS_ONLY" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "output_hash"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "output_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "INPUT_OBJECTS": { "type": "integer", "minimum": 0 },
    "state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CLEAN",
        "UPGRADED",
        "CORRECTED",
        "DEMOTED",
        "HOLD",
        "CONFLICT",
        "INDEXER_DRIFT",
        "TEMPORAL_DRIFT",
        "ROLE_COLLAPSE",
        "MISSING_RECEIPT",
        "ALIEN"
      ],
      "properties": {
        "CLEAN": { "type": "integer", "minimum": 0 },
        "UPGRADED": { "type": "integer", "minimum": 0 },
        "CORRECTED": { "type": "integer", "minimum": 0 },
        "DEMOTED": { "type": "integer", "minimum": 0 },
        "HOLD": { "type": "integer", "minimum": 0 },
        "CONFLICT": { "type": "integer", "minimum": 0 },
        "INDEXER_DRIFT": { "type": "integer", "minimum": 0 },
        "TEMPORAL_DRIFT": { "type": "integer", "minimum": 0 },
        "ROLE_COLLAPSE": { "type": "integer", "minimum": 0 },
        "MISSING_RECEIPT": { "type": "integer", "minimum": 0 },
        "ALIEN": { "type": "integer", "minimum": 0 }
      }
    },
    "OPERATORS_AVAILABLE": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1 }
    },
    "OPERATORS_USED": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "MANUAL_REVIEWS": { "type": "integer", "minimum": 0 },
    "manual_review_object_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "REPEATED_ERRORS_PREVENTED": { "type": "integer", "minimum": 0 },
    "AUTHORITY_CREATED": { "const": false },
    "authority": { "const": false },
    "authority_boundary": { "const": "NONE" },
    "mode": { "const": "evidence_reexamination" },
    "batch_start": { "type": "integer", "minimum": 0 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "inventory_class": { "type": "string", "minLength": 1 },
    "kernel_version": { "const": "REPLAY_KERNEL_V0_1" },
    "kernel_replay_invoked": { "const": false },
    "constitutional_root": { "const": "808f2b1c6c339eb46e68a2161da3cca22f7b0eeb" },
    "network": { "const": "NONE" },
    "secrets_used": { "const": false },
    "chain_data_fabricated": { "const": false },
    "promotion_performed": { "const": false },
    "design_inventory_size": { "const": 1024 },
    "design_batch_size": { "const": 32 },
    "fixture_note": { "type": "string" },
    "object_ids": { "type": "array", "items": { "type": "string" } },
    "queue_object_ids": { "type": "array", "items": { "type": "string" } },
    "specialist_object_ids": { "type": "array", "items": { "type": "string" } },
    "deep_replay_object_ids": { "type": "array", "items": { "type": "string" } },
    "receipt_object_ids": { "type": "array", "items": { "type": "string" } },
    "human_summary_ref": { "const": "docs/gray-baby/REPLAY_FACTORY_V1.md" },
    "scorekeeper_note": { "type": "string", "minLength": 1 },
    "receipt_writer_status": { "type": "string", "minLength": 1 }
  }
}
