{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.invalid/schemas/jaywisdom/gamification_membrane.v0_1.schema.json",
  "title": "JSONWisdom Gamification Membrane v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "game_id",
    "classification",
    "base_mapping",
    "roles",
    "arenas",
    "scoring",
    "promotion_gate",
    "laws",
    "authority_created"
  ],
  "properties": {
    "format": {"const": "JSONWISDOM_GAMIFICATION_MEMBRANE_V0.1"},
    "game_id": {"const": "LEAHPRIME_DICE_GAME_V0_1"},
    "classification": {"const": "SYNTHETIC_GAME_LAYER"},
    "base_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "path", "sha256"],
      "properties": {
        "mapping_id": {"const": "MIND_THE_GAP_DICE_V0_1"},
        "path": {"const": "fixtures/jaywisdom/challenge/MIND_THE_GAP_DICE_V0_1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dice_leahprime", "ziggy", "girlmath", "receiptos", "human"],
      "properties": {
        "dice_leahprime": {"const": "SCENARIO_PRESENTER"},
        "ziggy": {"const": "ADVERSARIAL_QUESTIONER"},
        "girlmath": {"const": "EVIDENCE_DENOMINATOR_AUDITOR"},
        "receiptos": {"const": "EVENT_RECORDER"},
        "human": {"const": "CONSEQUENTIAL_AUTHORITY"}
      }
    },
    "arenas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MIND_THE_GAP",
          "CLAIM_EVIDENCE",
          "DELTA_QUADRATIC_VOTING",
          "PARTICIPANT_VECTOR",
          "FAMILY_MAP",
          "RESUME_GITHUB",
          "DELTA_REPLAY"
        ]
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_accuracy", "gap_detection", "conflict_detection", "boundary_preservation", "overclaim_penalty", "score_changes_epistemic_state"],
      "properties": {
        "classification_accuracy": {"type": "integer", "minimum": 0},
        "gap_detection": {"type": "integer", "minimum": 0},
        "conflict_detection": {"type": "integer", "minimum": 0},
        "boundary_preservation": {"type": "integer", "minimum": 0},
        "overclaim_penalty": {"type": "integer", "maximum": 0},
        "score_changes_epistemic_state": {"const": false}
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_inputs", "forbidden_inputs"],
      "properties": {
        "allowed_inputs": {
          "type": "array",
          "const": ["EVIDENCE_TYPE_MATCH", "VERIFICATION_RESULT", "RULE_SCOPE_BINDING"]
        },
        "forbidden_inputs": {
          "type": "array",
          "const": ["DICE_ROLL", "PLAYER_SCORE", "VOTE_COUNT", "POPULARITY"]
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dice_selects_scenario_not_verdict",
        "score_does_not_create_evidence",
        "votes_do_not_create_evidence",
        "receipt_does_not_create_truth",
        "simulation_does_not_create_authority",
        "story_does_not_promote_history"
      ],
      "properties": {
        "dice_selects_scenario_not_verdict": {"const": true},
        "score_does_not_create_evidence": {"const": true},
        "votes_do_not_create_evidence": {"const": true},
        "receipt_does_not_create_truth": {"const": true},
        "simulation_does_not_create_authority": {"const": true},
        "story_does_not_promote_history": {"const": true}
      }
    },
    "authority_created": {"const": false}
  }
}
