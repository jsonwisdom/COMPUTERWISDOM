{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.example/schemas/onion_event_metadata.v0_2.schema.json",
  "title": "Congress 3.0 Onion Event Metadata v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": ["event_id", "observed_at", "layer", "evidence_state", "authority_created"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "occurred_at": {"type": ["string", "null"]},
    "source_published_at": {"type": ["string", "null"]},
    "jurisdiction": {"type": ["string", "null"]},
    "geography": {"type": ["string", "null"]},
    "layer": {
      "type": "string",
      "enum": [
        "CONGRESS_LAW",
        "WAR_NATIONAL_SECURITY",
        "COMMERCIAL_CORPORATE",
        "POLICY_REGULATION",
        "BANKING_FINANCE",
        "DIGITAL_ASSET_MARKET_STRUCTURE",
        "EXCHANGE_BROKER_DEALER",
        "CUSTODY",
        "SELF_CUSTODY_WALLET",
        "PUBLIC_BLOCKCHAIN",
        "FRAUD_SCAM_INFRASTRUCTURE",
        "FBI_DOJ_ENFORCEMENT",
        "AI_ANALYTICS",
        "STATE_FIELD_OFFICE",
        "CITIZEN_CONSEQUENCE",
        "REPLAY_RECEIPT"
      ]
    },
    "sub_layer": {"type": ["string", "null"]},
    "actor": {"type": ["string", "null"]},
    "actor_role": {"type": ["string", "null"]},
    "system": {"type": ["string", "null"]},
    "system_owner": {"type": ["string", "null"]},
    "system_operator": {"type": ["string", "null"]},
    "execution_identity": {"type": ["string", "null"]},
    "authority_source": {"type": ["string", "null"]},
    "authority_state": {"type": ["string", "null"]},
    "policy_or_rule": {"type": ["string", "null"]},
    "machine_rule": {"type": ["string", "null"]},
    "custody_model": {"type": ["string", "null"]},
    "wallet_model": {"type": ["string", "null"]},
    "asset_or_token": {"type": ["string", "null"]},
    "account_or_wallet_identifier": {"type": ["string", "null"]},
    "transaction_identifier": {"type": ["string", "null"]},
    "transaction_timestamp": {"type": ["string", "null"]},
    "transaction_amount": {"type": ["number", "string", "null"]},
    "counterparty": {"type": ["string", "null"]},
    "communication_channel": {"type": ["string", "null"]},
    "device_or_network_metadata": {"type": ["object", "array", "string", "null"]},
    "data_collected": {"type": ["array", "object", "string", "null"]},
    "data_derived": {"type": ["array", "object", "string", "null"]},
    "data_retention": {"type": ["string", "object", "null"]},
    "data_access": {"type": ["string", "object", "null"]},
    "data_sharing": {"type": ["string", "object", "null"]},
    "legal_process": {"type": ["string", "object", "null"]},
    "ai_use": {"type": ["string", "object", "null"]},
    "ai_output_role": {"type": ["string", "null"]},
    "human_review_required": {"type": ["boolean", "null"]},
    "record_delta": {"type": ["object", "string", "null"]},
    "citizen_consequence": {"type": ["object", "string", "null"]},
    "notice": {"type": ["object", "string", "null"]},
    "review_path": {"type": ["object", "string", "null"]},
    "correction_path": {"type": ["object", "string", "null"]},
    "source_uri": {"type": ["string", "null"]},
    "source_hash": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "string", "null"]},
    "evidence_state": {
      "type": "string",
      "enum": ["OFFICIAL", "OBSERVED", "DECLARED", "INFERENCE", "HOLD", "CONFLICT", "REJECT"]
    },
    "open_questions": {"type": "array", "items": {"type": "string"}, "default": []},
    "authority_created": {"const": false}
  }
}
