{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaywisdom.base.eth/contracts/BOXDEE_BYTE_REPLAY_RECEIPT_V1.schema.json",
  "title": "BOXDEE_BYTE_REPLAY_RECEIPT_V1",
  "description": "Deterministic receipt binding raw input bytes, RFC 8785 canonical input bytes, canonical P1 output bytes, and optional advisory-memory resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rawInputSha256",
    "rawInputByteLength",
    "canonicalInputSha256",
    "canonicalInputByteLength",
    "canonicalOutputSha256",
    "canonicalOutputByteLength",
    "memoryResolution",
    "derivedResult",
    "burdenSatisfied",
    "authority"
  ],
  "properties": {
    "schema": {"const": "BOXDEE_BYTE_REPLAY_RECEIPT_V1"},
    "rawInputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rawInputByteLength": {"type": "integer", "minimum": 0},
    "canonicalInputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonicalInputByteLength": {"type": "integer", "minimum": 0},
    "canonicalOutputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonicalOutputByteLength": {"type": "integer", "minimum": 0},
    "memoryResolution": {
      "type": ["object", "null"],
      "description": "When present, proves required remembered receipt bytes were re-read and bound before P1. Memory remains advisory only."
    },
    "derivedResult": {"enum": ["PASS", "HOLD", "DELTA", "FAIL"]},
    "burdenSatisfied": {"type": "boolean"},
    "authority": {"const": false}
  }
}
