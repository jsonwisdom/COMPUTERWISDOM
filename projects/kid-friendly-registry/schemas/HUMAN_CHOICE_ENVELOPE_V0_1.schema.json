{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUMAN_CHOICE_ENVELOPE_V0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "choice_id",
    "created_at",
    "human_actor",
    "trigger_receipts",
    "surface",
    "decision_class",
    "options",
    "selected_option",
    "execution_authorized",
    "authority_created",
    "append_only"
  ],
  "properties": {
    "choice_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "human_actor": {
      "const": "Jay"
    },
    "trigger_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "enum": [
        "GMAIL",
        "GOOGLE_DRIVE",
        "GITHUB",
        "DEVELOPMENT",
        "DOCUMENTATION",
        "PRESENTATION",
        "POLITICS",
        "POWERPOINT"
      ]
    },
    "decision_class": {
      "enum": [
        "AUDIT",
        "INVESTIGATE",
        "INVESTMENT_REVIEW",
        "SET_ASIDE",
        "TRANSFER_REVIEW",
        "PUBLISH_REVIEW",
        "POLICY_REVIEW",
        "DO_NOTHING"
      ]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "selected_option": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_confirmed": {
      "type": "boolean"
    },
    "execution_authorized": {
      "const": false
    },
    "authority_created": {
      "const": false
    },
    "append_only": {
      "const": true
    },
    "notes": {
      "type": "string"
    }
  }
}
